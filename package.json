{
  "name": "un-in-homemade",
  "private": true,
  "version": "1.0.0",
  "description": "Ủn Ỉn Homemade — game nuôi heo offline cho Windows",
  "author": "Ủn Ỉn Homemade",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "npm run typecheck && vite build && vite build --config vite.electron.config.ts",
    "dist:win": "npm run build && electron-builder --win nsis",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json && tsc -p tsconfig.electron.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "guard": "node .claude/skills/spec-to-source/scripts/check-architecture.mjs",
    "check": "npm run typecheck && npm run lint && npm run guard && npm run assets:check && npm run test",
    "icon": "node scripts/make-icon.mjs",
    "assets:placeholders": "tsx scripts/make-placeholders.ts",
    "assets:check": "tsx scripts/assets-check.ts",
    "art:process": "tsx scripts/process-art.ts",
    "sim:economy": "tsx scripts/simulate-economy.ts",
    "test:e2e": "npm run build && playwright test",
    "assets:release": "tsx scripts/assets-check.ts --release"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "phaser": "^3.90.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/pngjs": "^6.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.uninhomemade.game",
    "productName": "Ủn Ỉn Homemade",
    "executableName": "UnInHomemade",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ủn Ỉn Homemade",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "UnInHomemade-Setup-${version}.${ext}"
    }
  }
}
